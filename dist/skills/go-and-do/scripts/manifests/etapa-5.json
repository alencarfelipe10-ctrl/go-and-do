{
  "etapa": "5",
  "nome": "uat",
  "runlog_etapa": "5 uat",
  "asserts": [
    {
      "id": "pre_uat_executado",
      "tipo": "grep",
      "arquivo": "{fase}/{nn}-UAT.md",
      "regex": "^pre_uat: (generated|executed)",
      "min": 1,
      "desc": "pre_uat presente (a promoção generated→executed é DESTE script — 5.C)"
    },
    {
      "id": "cenarios_gravados",
      "tipo": "grep",
      "arquivo": "{fase}/{nn}-UAT.md",
      "regex": "result: *(pass|issue|blocked|assumed)",
      "min": 1,
      "desc": ">=1 cenário com result: gravado"
    }
  ]
}
