{
  "etapa": "2",
  "nome": "planejamento",
  "runlog_etapa": "2 planejamento",
  "asserts": [
    {
      "id": "has_plans",
      "tipo": "sdk",
      "query": "init.phase-op {n}",
      "jq": ".has_plans",
      "espera": "true",
      "desc": "retrato do SDK confirma planos"
    },
    {
      "id": "plan_files",
      "tipo": "glob",
      "padrao": "{fase}/*-PLAN.md",
      "min": 1,
      "desc": ">=1 PLAN.md no disco"
    }
  ],
  "extrai": [
    {
      "id": "nao_autonomos",
      "tipo": "grep-arquivos",
      "padrao": "{fase}/*-PLAN.md",
      "regex": "^autonomous: false",
      "desc": "planos autonomous:false — a camada 0 classifica (a)/(b)/(c) no fecho da etapa (2.H)"
    },
    {
      "id": "mapper_pulado",
      "tipo": "grep-arquivos",
      "padrao": "{fase}/{nn}-DECISOES.md",
      "regex": "mapper=pulado",
      "desc": "decisão do juiz 2.E no NN-DECISOES — a camada 0 cruza com planos que criam arquivo novo (sino, não retrabalho)"
    },
    {
      "id": "plan_gate",
      "tipo": "json",
      "arquivo": "{root}/.planning/.gad/last-plan-gate.json",
      "jq": "{passed, planos: .resumo.planos, ondas: .resumo.ondas, largura_max: .resumo.largura_max, avisos: [.avisos[]?.codigo]}",
      "ausente": "incidente",
      "desc": "plan shape gate (§13a-bis do plan-phase do fork) — informativo: o gate já bloqueia dentro do plan-phase; aqui a camada 0 vê planos/ondas/largura máx e os avisos que sobraram. Ausente = o gate não rodou → incidente no run-log"
    }
  ]
}
